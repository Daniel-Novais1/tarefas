package main

import (
	"fmt"
	"math"
)

func main() {
	var x float64
	fmt.Scan(&x)

	cos := 1.0
	sinal := -1.0
	fat := 1.0
	pot := 1.0

	for i := 1; i <= 20; i++ {
		pot *= x * x
		fat *= float64(2*i-1) * float64(2*i)
		cos += sinal * pot / fat
		sinal *= -1
	}

	fmt.Println(cos)
	fmt.Println(math.Cos(x) - cos)
}
