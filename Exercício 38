package main

import "fmt"

func main() {
	var cpf string
	fmt.Scan(&cpf)

	soma := 0
	peso := 10

	for i := 0; i < 9; i++ {
		d := int(cpf[i] - '0')
		soma += d * peso
		peso--
	}

	resto := soma % 11
	d1 := 0
	if resto >= 2 {
		d1 = 11 - resto
	}

	soma = 0
	peso = 11

	for i := 0; i < 9; i++ {
		d := int(cpf[i] - '0')
		soma += d * peso
		peso--
	}
	soma += d1 * 2

	resto = soma % 11
	d2 := 0
	if resto >= 2 {
		d2 = 11 - resto
	}

	if int(cpf[9]-'0') == d1 && int(cpf[10]-'0') == d2 {
		fmt.Println("Valido")
	} else {
		fmt.Println("Invalido")
	}
}
